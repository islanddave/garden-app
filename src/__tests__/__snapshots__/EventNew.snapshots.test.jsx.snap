            style="background: none; cursor: pointer; color: rgb(74, 74, 74); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; padding: 0px; min-height: 44px; width: 100%; display: flex; align-items: center; gap: 6px;"
            type="button"
          >
            <span
              aria-hidden="true"
            >
              ▸
            </span>
            <span>
              Notes  ·  optional
            </span>
          </button>
        </div>
        <div
          aria-hidden="true"
          style="height: 120px;"
        />
        <div
          data-testid="save-sticky"
          style="position: sticky; bottom: 68px; z-index: 1; display: flex; flex-direction: column; visibility: visible; pointer-events: none;"
        >
          <div
            style="display: flex; align-items: center; gap: 12px; justify-content: flex-end; padding: 0px 0px 0px 0px;"
          >
            <button
              style="background-color: rgb(45, 106, 79); color: rgb(255, 255, 255); border-radius: 8px; padding: 13px 30px; font-size: 0.95rem; font-weight: 700; cursor: pointer; min-height: 48px; font-family: inherit; line-height: 1.2; box-shadow: 0 2px 12px rgba(0,0,0,0.18); min-width: 180px; pointer-events: auto;"
              type="button"
            >
              Save
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
`;

exports[`EventNew — rendered form per event type > seed_saved 1`] = `
<div>
  <div
    style="position: fixed; inset: 0; z-index: 190; background-color: rgba(0, 0, 0, 0.3);"
  />
  <div
    aria-label="Save seed"
    aria-modal="true"
    role="dialog"
    style="position: fixed; bottom: 0px; left: 0px; right: 0px; max-height: 85vh; box-sizing: content-box; overflow-y: auto; background-color: rgb(255, 255, 255); border-radius: 16px 16px 0 0; box-shadow: 0 -4px 20px rgba(0,0,0,0.14); z-index: 200; padding-top: 8px; padding-bottom: calc(12px + env(safe-area-inset-bottom)); outline: none;"
    tabindex="-1"
  >
    <div
      style="width: 36px; height: 4px; border-radius: 2px; background-color: rgb(212, 201, 190); margin: 0px auto 8px;"
    />
    <div
      style="display: flex; align-items: flex-start; gap: 8px; padding: 0px 8px 4px;"
    >
      <div
        style="flex: 1 1 0%; padding: 4px 16px 4px; font-size: 1rem; font-weight: 700; color: rgb(26, 26, 26);"
      >
        Save seed
      </div>
      <button
        aria-label="Close"
        data-sheet-close="true"
        style="flex-shrink: 0; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: transparent; color: rgb(74, 74, 74); cursor: pointer; border-radius: 8px;"
        type="button"
      >
        <svg
          aria-hidden="true"
          fill="none"
          height="22"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="2.2"
          viewBox="0 0 24 24"
          width="22"
        >
          <path
            d="M6 6l12 12M18 6L6 18"
          />
        </svg>
      </button>
    </div>
    <div
      data-testid="save-seed-from"
      style="margin: 0px 0px 14px;"
    >
      <div
        id="save-seed-from-label"
        style="font-size: 0.82rem; font-weight: 600; color: rgb(74, 74, 74);"
      >
        From
      </div>
      <ul
        aria-labelledby="save-seed-from-label"
        style="list-style: none; margin: 2px 0px 0px; padding: 0px;"
      >
        <li
          data-testid="save-seed-from-row"
          style="display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 44px; border-bottom: 1px solid rgb(212, 201, 190);"
        >
          <span
            style="flex: 1 1 0%; min-width: 0; overflow-wrap: anywhere; padding: 8px 0px; color: rgb(26, 26, 26); font-size: 0.95rem;"
          >
            Sungold #1
          </span>
        </li>
      </ul>
      <label
        style="display: block; margin-bottom: 0px; font-size: 0.82rem; font-weight: 600; color: rgb(74, 74, 74); margin-top: 10px;"
      >
        About how many separate plants did you gather this seed from?
        <input
          aria-describedby="save-seed-plant-count-note"
          data-testid="save-seed-plant-count"
          inputmode="numeric"
          max="9999"
          min="1"
          step="1"
          style="display: block; width: 100%; min-height: 48px; margin-top: 6px; padding: 0px 12px; border-radius: 8px; border: 1px solid rgb(212, 201, 190); font-size: 1rem; background-color: rgb(255, 255, 255);"
          type="number"
          value=""
        />
      </label>
      <p
        data-testid="save-seed-plant-count-note"
        id="save-seed-plant-count-note"
        style="margin: 6px 0px 0px; color: rgb(74, 74, 74); font-size: 0.78rem; line-height: 1.5;"
      >
        Single plants, not the plantings listed above. Count each plant once, however often you picked from it. Leave it blank if you can't say.
        <span
          data-testid="save-seed-plant-count-hint"
          style="display: block;"
        >
          This planting holds 4 plants today.
        </span>
      </p>
    </div>
    <label
      style="display: block; margin-bottom: 14px; font-size: 0.82rem; font-weight: 600; color: rgb(74, 74, 74);"
    >
      Lot name
      <input
        data-testid="save-seed-name"
        style="display: block; width: 100%; min-height: 48px; margin-top: 6px; padding: 0px 12px; border-radius: 8px; border: 1px solid rgb(212, 201, 190); font-size: 1rem; background-color: rgb(255, 255, 255);"
        type="text"
        value="Sungold #1 — saved 2026"
      />
    </label>
    <div
      style="display: block; margin-bottom: 14px; font-size: 0.82rem; font-weight: 600; color: rgb(74, 74, 74);"
    >
      Variety
    </div>
    <div
      data-testid="save-seed-variety-picker"
      style="margin-bottom: 14px;"
    >
      <div
        style="position: relative;"
      >
        <input
          aria-autocomplete="list"
          aria-expanded="false"
          aria-required="true"
          autocomplete="off"
          id="save-seed-variety"
          inputmode="none"
          placeholder="Search varieties…"
          role="combobox"
          style="width: 100%; padding: 10px 12px; border: 1px solid rgb(212, 201, 190); border-radius: 7px; font-size: 0.9rem; background-color: rgb(255, 255, 255); box-sizing: border-box; font-family: inherit; cursor: text; min-height: 44px;"
          type="text"
          value=""
        />
      </div>
      <p
        data-testid="save-seed-no-variety"
        style="margin: 6px 0px 0px; color: rgb(74, 74, 74); font-size: 0.78rem; line-height: 1.5;"
      >
        This planting has no variety recorded. Pick the variety this seed came from — a seed lot has to name one.
      </p>
    </div>
    <label
      style="display: block; margin-bottom: 0px; font-size: 0.82rem; font-weight: 600; color: rgb(74, 74, 74);"
    >
      How many seeds?
       
      <span
        style="color: rgb(112, 112, 112); font-weight: 400;"
      >
        (optional)
      </span>
      <input
        aria-describedby="save-seed-count-note"
        data-testid="save-seed-count"
        inputmode="numeric"
        min="0"
        placeholder="e.g. 20"
        step="1"
        style="display: block; width: 100%; min-height: 48px; margin-top: 6px; padding: 0px 12px; border-radius: 8px; border: 1px solid rgb(212, 201, 190); font-size: 1rem; background-color: rgb(255, 255, 255);"
        type="number"
        value=""
      />
    </label>
    <button
      aria-checked="false"
      data-testid="save-seed-count-estimated"
      role="switch"
      style="display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; min-height: 44px; margin: 6px 0px 14px; padding: 0px 12px; border-radius: 8px; cursor: pointer; border: 1px solid rgb(212, 201, 190); background-color: rgb(255, 255, 255); color: rgb(74, 74, 74); font-size: 0.82rem; font-weight: 400;"
      type="button"
    >
      <span
        aria-hidden="true"
        style="display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 18px; height: 18px; border-radius: 4px; border: 1px solid rgb(212, 201, 190); background-color: rgb(255, 255, 255); color: rgb(255, 255, 255); font-size: 0.7rem; line-height: 1;"
      />
      Approximate — not hand-counted
    </button>
    <p
      data-testid="save-seed-count-note"
      id="save-seed-count-note"
      style="margin: 0px 0px 14px; color: rgb(74, 74, 74); font-size: 0.78rem; line-height: 1.5;"
    >
      Leave it blank if the seed is still wet and unthreshed. You can set or change the count at every step, and you'll be asked for a final one when you mark the lot stored.
    </p>
    <label
      style="display: block; margin-bottom: 14px; font-size: 0.82rem; font-weight: 600; color: rgb(74, 74, 74);"
    >
      Or a weight 
      <span
        style="color: rgb(112, 112, 112); font-weight: 400;"
      >
        (optional)
      </span>
      <input
        aria-describedby="save-seed-weight-note"
        data-testid="save-seed-weight"
        inputmode="decimal"
        placeholder="e.g. 2.5 g"
        style="display: block; width: 100%; min-height: 48px; margin-top: 6px; padding: 0px 12px; border-radius: 8px; border: 1px solid rgb(212, 201, 190); font-size: 1rem; background-color: rgb(255, 255, 255);"
        type="text"
        value=""
      />
    </label>
    <p
      data-testid="save-seed-weight-note"
      id="save-seed-weight-note"
      style="margin: 0px 0px 14px; color: rgb(74, 74, 74); font-size: 0.78rem; line-height: 1.5;"
    >
      Whichever the packet tells you — a count or a weight. A bare number is GRAMS; type “mg” after it for milligrams, e.g. 250 mg.
    </p>
    <div
      id="save-seed-process-label"
      style="display: block; margin-bottom: 14px; font-size: 0.82rem; font-weight: 600; color: rgb(74, 74, 74);"
    >
      Start tracking it?
    </div>
    <div
      aria-labelledby="save-seed-process-label"
      role="group"
      style="margin-bottom: 14px;"
    >
      <button
        aria-pressed="true"
