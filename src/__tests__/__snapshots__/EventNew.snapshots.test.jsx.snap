          </label>
          <div>
            <div
              style="display: flex; gap: 10px;"
            >
              <button
                style="flex: 1 1 0%; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 18px 12px; border: 2px dashed rgb(212, 201, 190); border-radius: 8px; cursor: pointer; background-color: rgb(255, 255, 255); color: rgb(74, 74, 74); font-size: 0.88rem; font-weight: 600;"
                type="button"
              >
                <svg
                  aria-hidden="true"
                  fill="none"
                  height="20"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.4"
                  viewBox="0 0 24 24"
