                type="button"
              >
                ✕
              </button>
            </div>
            <button
              aria-describedby="ps-list-rs-chip-label"
              style="background: none; cursor: pointer; color: rgb(45, 106, 79); font-size: 0.82rem; font-weight: 600; text-decoration: underline; padding: 8px 6px; min-height: 44px;"
              type="button"
            >
              Change
            </button>
          </div>
        </div>
        <div
          style="background-color: rgb(255, 255, 255); border: 1px solid rgb(212, 201, 190); border-radius: 10px; padding: 12px 18px;"
        >
          <button
            aria-expanded="false"
            style="background: none; cursor: pointer; color: rgb(74, 74, 74); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; padding: 0px; min-height: 44px; display: flex; align-items: center; gap: 6px;"
            type="button"
          >
            <span
              aria-hidden="true"
            >
              ▸
            </span>
            <span>
              Add details  ·  optional
            </span>
          </button>
        </div>
        <div
          style="background-color: rgb(255, 255, 255); border: 1px solid rgb(212, 201, 190); border-radius: 10px; padding: 16px 18px;"
        >
          <label
            style="display: block; font-size: 0.77rem; font-weight: 700; color: rgb(74, 74, 74); margin-bottom: 10px; letter-spacing: 0.4px; text-transform: uppercase;"
          >
            When?
          </label>
          <input
            aria-label="Event date"
            style="width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid rgb(212, 201, 190); border-radius: 7px; font-size: 0.9rem; background-color: rgb(255, 255, 255); box-sizing: border-box; font-family: inherit; color: rgb(26, 26, 26);"
            type="date"
            value="2026-07-15"
          />
        </div>
        <div
          style="background-color: rgb(255, 255, 255); border: 1px solid rgb(212, 201, 190); border-radius: 10px; padding: 12px 18px;"
        >
          <button
            aria-expanded="false"
            data-testid="notes-disclosure"
            style="background: none; cursor: pointer; color: rgb(74, 74, 74); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; padding: 0px; min-height: 44px; width: 100%; display: flex; align-items: center; gap: 6px;"
            type="button"
          >
            <span
              aria-hidden="true"
            >
              ▸
            </span>
            <span>
              Notes  ·  optional
            </span>
          </button>
        </div>
        <div
          aria-hidden="true"
          style="height: 120px;"
        />
        <div
          data-testid="save-sticky"
          style="position: sticky; bottom: 68px; z-index: 1; display: flex; flex-direction: column; visibility: visible; pointer-events: none;"
        >
          <div
            style="display: flex; align-items: center; gap: 12px; justify-content: flex-end; padding: 0px 0px 0px 0px;"
          >
            <button
              style="background-color: rgb(45, 106, 79); color: rgb(255, 255, 255); border-radius: 8px; padding: 13px 30px; font-size: 0.95rem; font-weight: 700; cursor: pointer; min-height: 48px; font-family: inherit; line-height: 1.2; box-shadow: 0 2px 12px rgba(0,0,0,0.18); min-width: 180px; pointer-events: auto;"
              type="button"
            >
              Save
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
`;

