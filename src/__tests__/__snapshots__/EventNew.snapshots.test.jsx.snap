exports[`EventNew — rendered form per event type > reduction_lost 1`] = `
<div>
  <div
    style="min-height: calc(100dvh - 52px); background-color: rgb(248, 245, 240);"
  >
    <div
      style="max-width: 600px; margin: 0px auto; padding: 28px 16px 60px;"
