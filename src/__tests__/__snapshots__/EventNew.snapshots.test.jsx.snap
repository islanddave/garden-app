            <button
              style="padding: 14px 6px 12px; border: 2px solid rgb(212, 201, 190); border-radius: 10px; background-color: rgb(255, 255, 255); cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 7px; transition: all 0.12s; min-height: 80px;"
