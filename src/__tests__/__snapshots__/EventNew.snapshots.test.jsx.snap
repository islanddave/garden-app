        style="display: block; width: 100%; text-align: left; min-height: 64px; padding: 12px; margin-bottom: 10px; border-radius: 8px; cursor: pointer; border: 1px solid rgb(45, 106, 79); background-color: rgb(216, 243, 220); color: rgb(26, 26, 26);"
        type="button"
      >
        <span
          style="font-weight: 600;"
        >
          Not yet — just save the lot
        </span>
        <span
          style="display: block; color: rgb(112, 112, 112); font-size: 0.78rem; margin-top: 2px;"
        >
