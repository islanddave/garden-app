node_modules/
dist/
.env*
.DS_Store
*.local

# ignore a node_modules symlink too (dir-only pattern above misses symlinks)
node_modules

# vitest's transpiled temp config — normally cleaned up, but left behind on a crashed/killed
# run. 94 had accumulated (Jun 3 - Jul 1) before this rule; untracked, but enough to bury real
# changes in git status.
vitest.config.ts.timestamp-*.mjs
vite.config.ts.timestamp-*.mjs

# python bytecode from the scripts/ guards (check-coverage-ratchet, check-release-version, snap,
# verify-deploy). Running their pytest suites leaves __pycache__ behind; same burial problem as above.
__pycache__/
*.py[cod]

# vitest coverage output — build artifact, regenerated by CI before the ratchet reads it. Was
# tracked until 2026-08-03; 462 stale files rode along on any `git add -A` (one unintended
# 221k-line deletion shipped inside a care-engine commit and CI stayed green through it).
coverage/

# CodeGraph local index — machine-local, never committed
.codegraph/

# harvest-weight-ratchet run report — regenerated on every --dry-run/--apply (and by the weekly
# workflow). The durable record of an apply is the harvest_log_weight_snapshot_* table plus the
# ack file's review entries, not this artifact.
harvest-ratchet-report.json
