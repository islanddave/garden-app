{
  "name": "garden-app",
  "private": true,
  "version": "4.113.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "gate:sw-mirror": "node scripts/check-sw-mirror.mjs",
    "gate:save-band": "node scripts/layout-gate/save-band-clearance.mjs",
    "gate:log-chooser": "node scripts/layout-gate/log-chooser-clearance.mjs",
    "gate:phototier-bytes": "node scripts/layout-gate/phototier-bytes.mjs --surface today --count 20 --max-bytes 4000000",
    "phototier-bytes:before": "node scripts/layout-gate/phototier-bytes.mjs --surface today --count 20 --tier none --max-bytes 4000000",
    "gate:iconwire4": "node scripts/layout-gate/iconwire4-shot.mjs --outdir artifacts/layout-gate",
    "gate:inventory-list": "node scripts/layout-gate/inventory-list-shot.mjs --out artifacts/layout-gate/inventory-list-390x844.png",
    "gate:seeds-saved": "node scripts/layout-gate/seeds-saved-clearance.mjs",
    "gate:seeds-saved:probe-nothing": "node scripts/layout-gate/seeds-saved-clearance.mjs --probe-nothing",
    "gen:event-types": "node scripts/gen-lambda-event-types.mjs",
    "check:event-types": "node scripts/gen-lambda-event-types.mjs --check",
    "lint": "eslint .",
    "icon:golden": "node scripts/icon-ci/optical-weight.mjs",
    "icon:golden:update": "node scripts/icon-ci/optical-weight.mjs --update",
    "icon:seam": "node scripts/icon-ci/region-seam.mjs",
    "icon:distinct": "node scripts/icon-ci/glyph-distinctness.mjs",
    "parity:golden": "node scripts/parity/capture-daily-plan-golden.mjs --check",
    "parity:golden:update": "node scripts/parity/capture-daily-plan-golden.mjs",
    "parity:garden-render": "node scripts/parity/garden-render-golden.mjs",
    "parity:garden-render:update": "node scripts/parity/garden-render-golden.mjs --update",
    "gate:save-band-stability": "node scripts/layout-gate/save-band-stability.mjs",
    "gate:save-band-stability:report": "node scripts/layout-gate/save-band-stability.mjs --report"
  },
  "dependencies": {
    "@clerk/react": "^6.12.7",
    "exifr": "^7.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-image-crop": "^11.0.5",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "fake-indexeddb": "^6.2.5",
    "js-yaml": "^4.2.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.9",
    "vitest": "^2.0.0",
    "ws": "^8.20.0"
  }
}
