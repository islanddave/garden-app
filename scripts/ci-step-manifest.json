    {
      "env": {
        "ACTIONLINT_SHA256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8",
        "ACTIONLINT_VERSION": "1.7.12",
        "SHELLCHECK_OPTS": "--severity=warning",
        "SHELLCHECK_SHA256": "b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6",
        "SHELLCHECK_VERSION": "v0.11.0"
      },
      "name": "Workflow lint (actionlint + shellcheck, pinned and checksum-verified)",
      "other": {},
      "run": [
        "set -euo pipefail",
        "T=\"$RUNNER_TEMP/wflint\"",
        "mkdir -p \"$T\"",
        "curl -sSfL --retry 3 --retry-connrefused -o \"$T/actionlint.tgz\" \\",
        "  \"https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz\"",
        "curl -sSfL --retry 3 --retry-connrefused -o \"$T/shellcheck.tgz\" \\",
        "  \"https://github.com/koalaman/shellcheck/releases/download/${SHELLCHECK_VERSION}/shellcheck-${SHELLCHECK_VERSION}.linux.x86_64.tar.gz\"",
        "echo \"${ACTIONLINT_SHA256}  $T/actionlint.tgz\" | sha256sum -c -",
        "echo \"${SHELLCHECK_SHA256}  $T/shellcheck.tgz\" | sha256sum -c -",
        "tar -xzf \"$T/actionlint.tgz\" -C \"$T\" actionlint",
        "tar -xzf \"$T/shellcheck.tgz\" -C \"$T\" \"shellcheck-${SHELLCHECK_VERSION}/shellcheck\"",
        "\"$T/actionlint\" -version",
        "SC=\"$T/shellcheck-${SHELLCHECK_VERSION}/shellcheck\"",
        "# Canary: rejected by actionlint AND by shellcheck, under this repo's own config, or nothing below counts.",
        "mkdir -p \"$T/canary/.github/workflows\"",
        "[ ! -f .github/actionlint.yaml ] || cp .github/actionlint.yaml \"$T/canary/.github/\"",
        "git -C \"$T/canary\" init -q",
        "cat > \"$T/canary/.github/workflows/canary.yml\" <<'CANARY'",
        "on: push",
        "jobs:",
        "  canary:",
        "    needs: no-such-job",
        "    runs-on: ubuntu-latest",
        "    steps:",
        "      - run: unused=1",
        "CANARY",
        "RC=0",
        "(cd \"$T/canary\" && \"$T/actionlint\" -oneline -shellcheck=\"$SC\" -pyflakes=) > \"$T/canary.out\" 2>&1 || RC=$?",
        "if [ \"$RC\" -ne 1 ] || ! grep -q '\\[job-needs\\]' \"$T/canary.out\" || ! grep -q 'SC2034:warning' \"$T/canary.out\"; then",
        "  cat \"$T/canary.out\"",
        "  echo \"::error title=Workflow lint canary::the lint did not reject its known-bad fixture (exit $RC; want 1 with a [job-needs] and an SC2034 warning). A clean run would verify nothing.\"",
        "  exit 1",
        "fi",
        "RC=0",
        "\"$T/actionlint\" -color -verbose -shellcheck=\"$SC\" -pyflakes= 2> \"$T/lint.err\" || RC=$?",
        "if [ \"$RC\" -ne 0 ]; then",
        "  [ \"$RC\" -eq 1 ] || cat \"$T/lint.err\"  # 1 = findings, printed above; anything else is fatal",
        "  exit \"$RC\"",
        "fi",
        "LINTED=$(awk '/Linting [0-9]+ files/ { for (i = 1; i < NF; i++) if ($i == \"Linting\") { print $(i + 1); exit } }' \"$T/lint.err\")",
        "ONDISK=$(find .github/workflows -maxdepth 1 -type f \\( -name '*.yml' -o -name '*.yaml' \\) | wc -l | tr -d ' ')",
        "if [ \"${LINTED:-0}\" -ne \"$ONDISK\" ] || grep -q 'Rule \"shellcheck\" was disabled' \"$T/lint.err\"; then",
        "  cat \"$T/lint.err\"",
        "  echo \"::error title=Workflow lint vacuous::linted ${LINTED:-0} of $ONDISK workflow files, or shellcheck was disabled (verbose log above).\"",
        "  exit 1",
        "fi",
        "echo \"Workflow lint: $LINTED of $ONDISK workflow files clean under actionlint + shellcheck; the canary was rejected as required.\"",
        ""
      ],
